{
  "name": "brandkit",
  "version": "0.1.0",
  "private": true,
  "description": "Brand kits from one brand.json: logos and signatures, stationery, publications, signs, vehicles, a brand guide and web files, generated in the browser. With the 1977 Province of British Columbia and 1983 BC Hydro identities as worked examples, and a viewer for identity manuals.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "brandkit": "./bin/brandkit.mjs"
  },
  "exports": {
    ".": "./src/engine/index.js",
    "./engine": "./src/engine/index.js",
    "./fonts": "./src/fonts/provider.js",
    "./fonts/node": "./src/fonts/node.js",
    "./export": "./src/export/render.js",
    "./manuals": "./src/manuals/index.js",
    "./manuals/bc": "./manuals/bc/index.js",
    "./studio": "./src/studio/TemplateStudio.jsx",
    "./vite": "./src/vite.js",
    "./printer": "./src/printer/package.js",
    "./printer/bridge": "./src/printer/bridge.js",
    "./package.json": "./package.json",
    "./documents": "./src/export/publication.js",
    "./documents/node": "./src/export/node.js",
    "./documentation": "./src/engine/documentation.js",
    "./consumer": "./src/engine/consumer.js",
    "./patterns": "./src/engine/pattern-catalog.js"
  },
  "files": [
    "bin",
    "src",
    "brands",
    "manuals",
    "docs"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "setup:printer": "cd vendor/template-printer/frontend && corepack pnpm install --frozen-lockfile",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.js\"",
    "build:kit": "node bin/brandkit.mjs build",
    "make:example": "node scripts/make-example-brand.mjs",
    "import:pofbc": "node scripts/import-pofbc.mjs",
    "make:ddcnorth": "node scripts/brands/ddcnorth-applications.mjs && node scripts/brands/ddcnorth-accept-v23.mjs",
    "make:firstform": "node scripts/brands/firstform.mjs",
    "make:overtheedge": "node scripts/brands/overtheedge.mjs",
    "make:sparklab": "node scripts/brands/sparklab.mjs",
    "make:unbc": "node scripts/brands/unbc.mjs",
    "make:bc": "node scripts/brands/bc-province-1977.mjs && node scripts/brands/bc-hydro-1983.mjs",
    "make:ddcnorth-v23": "node scripts/brands/ddcnorth-v23.mjs && node scripts/brands/ddcnorth-accept-v23.mjs",
    "test:browser": "node test/browser/ddcnorth-motion.check.mjs",
    "test:sparklab:browser": "node test/browser/sparklab.check.mjs",
    "make:patterns": "node scripts/brands/pattern-collections.mjs",
    "test:patterns:browser": "node test/browser/pattern-collections.check.mjs",
    "test:identity": "node test/browser/overtheedge-identity.check.mjs",
    "make:documentation": "node scripts/brands/documentation.mjs",
    "build:documentation": "node scripts/build-documentation.mjs",
    "test:documents": "node --test test/documentation-model.test.js test/office-documents.test.js test/documentation-exports.test.js",
    "test:documents:pagination": "node --test test/native-word-pagination.test.js",
    "test:documents:browser": "node test/browser/documentation.check.mjs",
    "test:patterns:view:browser": "node test/browser/patterns-view.check.mjs",
    "test:unbc:browser": "node test/browser/unbc.check.mjs",
    "test:hydro:browser": "node test/browser/bc-hydro.check.mjs",
    "audit:hydro": "node scripts/audit-bc-hydro.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "bwip-js": "^4.11.4",
    "docx": "^9.12.0",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "jspdf": "^3.0.4",
    "mp4-muxer": "^5.2.2",
    "opentype.js": "^2.0.0",
    "pptxgenjs": "^4.0.1",
    "svg2pdf.js": "^2.8.1",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@bcgov/bc-sans": "2.1.2",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.54.0",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "tailwindcss": "^4.2.2",
    "vite": "^8.3.4"
  }
}
