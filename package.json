{
  "name": "brandkit",
  "version": "0.1.0",
  "private": true,
  "description": "Brand kits from one brand.json: logos and signatures, stationery, publications, signs, vehicles, a brand guide and web files, generated in the browser. Brands open from brand packs (one zip each) by link or catalog; one example brand is built in, with a viewer for identity manuals.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "brandkit": "./bin/brandkit.mjs"
  },
  "exports": {
    ".": "./src/engine/index.js",
    "./engine": "./src/engine/index.js",
    "./fonts": "./src/fonts/provider.js",
    "./fonts/node": "./src/fonts/node.js",
    "./export": "./src/export/render.js",
    "./manuals": "./src/manuals/index.js",
    "./manuals/bc": "./manuals/bc/index.js",
    "./studio": "./src/studio/TemplateStudio.jsx",
    "./vite": "./src/vite.js",
    "./printer": "./src/printer/package.js",
    "./printer/bridge": "./src/printer/bridge.js",
    "./package.json": "./package.json",
    "./documents": "./src/export/publication.js",
    "./documents/node": "./src/export/node.js",
    "./documentation": "./src/engine/documentation.js",
    "./consumer": "./src/engine/consumer.js",
    "./patterns": "./src/engine/pattern-catalog.js",
    "./pack": "./src/pack/format.js",
    "./pack/node": "./src/pack/build.js",
    "./pack/host": {
      "types": "./src/pack/host.d.ts",
      "default": "./src/pack/host.js"
    },
    "./pack/host-node": {
      "types": "./src/pack/archive-node.d.ts",
      "default": "./src/pack/archive-node.js"
    },
    "./pack/catalog-cli": "./src/pack/catalog-cli.js"
  },
  "files": [
    "bin",
    "src",
    "brands",
    "library",
    "manuals",
    "docs"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "setup:printer": "cd vendor/template-printer/frontend && corepack pnpm install --frozen-lockfile",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.js\"",
    "build:kit": "node bin/brandkit.mjs build",
    "make:example": "node scripts/make-example-brand.mjs",
    "make:documentation": "node scripts/brands/documentation.mjs",
    "build:documentation": "node scripts/build-documentation.mjs",
    "pack": "node scripts/pack.mjs",
    "test:packs:browser": "node test/browser/packs.check.mjs",
    "make:patterns": "node scripts/brands/pattern-collections.mjs",
    "catalog": "node scripts/catalog.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "bwip-js": "^4.11.4",
    "docx": "^9.12.0",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "jspdf": "^3.0.4",
    "mp4-muxer": "^5.2.2",
    "opentype.js": "^2.0.0",
    "pptxgenjs": "^4.0.1",
    "svg2pdf.js": "^2.8.1",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@bcgov/bc-sans": "2.1.2",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.54.0",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "tailwindcss": "^4.2.2",
    "vite": "^8.3.4"
  }
}
