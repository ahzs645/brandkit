  "localAssumptions": [
    {
      "id": "community-agency",
      "choice": "Give local participation and continued care separate fields in every project brief.",
      "rationale": "Official methodology treats community leadership and sustainability as integral throughout the work.",
      "sourceIds": [
        "lf-methodology",
        "lf-faq"
      ],
      "status": "inferred-local-application",
      "confidence": "high"
    },
    {
      "id": "amount-free-default",
      "choice": "Leave donation amount and currency empty in evergreen templates.",
      "rationale": "Localized current pages contain multiple amounts/currencies without resolving their relationship.",
      "sourceIds": [
        "lf-es-home",
        "lf-pt-home"
      ],
      "status": "inferred-local-application",
      "confidence": "high"
    },
    {
      "id": "explicit-geography",
      "choice": "Store country and location explicitly and require evidence for them.",
      "rationale": "Some current project return-link labels are inconsistent with the project context.",
      "sourceIds": [
        "lf-project-la-z",
        "lf-project-guildford",
        "lf-news-la-z-2026"
      ],
      "status": "inferred-local-application",
      "confidence": "high"
    },
    {
      "id": "separate-event-dates",
      "choice": "Store event dates separately from article publication and update dates.",
      "rationale": "Several live stories have newer page updates than the events or campaigns they describe.",
      "sourceIds": [
        "lf-news-penrose-2026",
        "lf-news-safehub-2025",
        "lf-news-thread-future-2022"
      ],
      "status": "inferred-local-application",
      "confidence": "high"
    },
    {
      "id": "overlapping-associations",
      "choice": "Allow a project to have multiple initiative, partnership or campaign associations.",
      "rationale": "Penrose is described within both Philly Plays and Power to Play.",
      "sourceIds": [
        "lf-news-penrose-2026"
      ],
      "status": "inferred-local-application",
      "confidence": "high"
    },
    {
      "id": "source-bound-metrics",
      "choice": "Use null metric defaults and provide scope, period, definition and source fields.",
      "rationale": "Website counters differ by locale and questionnaire percentages need their original study context.",
      "sourceIds": [
        "lf-methodology",
        "lf-es-home",
        "lf-pt-home"
      ],
      "status": "inferred-local-application",
      "confidence": "high"
    },
    {
      "id": "campaign-separation",
      "choice": "Keep campaign names, milestone numbers, anniversary copy and partner graphics optional and dated.",
      "rationale": "The live site spans historical campaigns, annual reports and current institutional content.",
      "sourceIds": [
        "lf-100",
        "lf-home",
        "lf-news-thread-future-2022",
        "lf-report-2024",
        "lf-report-2025"
      ],
      "status": "inferred-local-application",
      "confidence": "high"
    },
    {
      "id": "locale-not-currency",
